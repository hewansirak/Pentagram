# --- Live mode (all three required; otherwise the app runs in demo mode) ---

# URL of your deployed Modal `generate` endpoint (printed by `modal deploy`)
MODAL_URL=https://<your-workspace>--stability-diffusion-model-generate.modal.run

# Must match the API_KEY value stored in the Modal secret named "API_KEY"
API_KEY=

# From Vercel -> Storage -> Blob (used to store generated images and the gallery index)
BLOB_READ_WRITE_TOKEN=
